#define MAX 100
using TipoDato = int;
/*************************************************************/
//                      pila.h
/*************************************************************/
class Pilaestatica
{
private:
    int pila[MAX];
    int cima;

public:
    Pilaestatica();
    bool Apilar(TipoDato& elemento);
    bool Desapilar();
    bool CimaPila(TipoDato& elemento);
    void LimpiarPila();
    void VerPila();
    bool PilaVacia();
    bool Iguales(Pilaestatica p);

};
//cpp
#include "Pilaestatica.h"
#include <iostream>

using namespace std;


Pilaestatica::Pilaestatica()
{
    cima = -1;
}

bool Pilaestatica::Apilar(TipoDato& elemento)
{
    bool res;
    if (cima == MAX - 1)
    {
        cout << "Desbordamiento de Pila (Overflow)" << endl;
        res = false;
    }
    else

    {
        cima++;
        pila[cima] = elemento;
        res = true;
    }
    return res;


}

