bool Pilaestatica::PilaVacia()
{
    return cima == -1;
}

void Pilaestatica::LimpiarPila()
{
    cima = -1;
}


bool Pilaestatica::Iguales(Pilaestatica p)
{
    if (cima != p.cima)
        return false;
        for (int i = 0; i <= cima; i++)
            if (pila[i] != p.pila[i])
                return false;
    return true;
}
